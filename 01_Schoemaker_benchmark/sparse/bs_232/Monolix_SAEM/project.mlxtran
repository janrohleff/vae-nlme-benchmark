<DATAFILE>

[FILEINFO]
file = 'bs_232.csv'
delimiter = comma
header = {ID, TIME, DV, MDV, AMT, EVID, DOSE, VI, CLI, KAI}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
DV = {use=observation, name=DV, type=continuous}
MDV = {use=missingdependentvariable}
AMT = {use=amount}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {Cl_pop, omega_Cl, V_pop, omega_V, ka_pop, omega_ka}

DEFINITION:
Cl = {distribution=logNormal, typical=Cl_pop, sd=omega_Cl}
V = {distribution=logNormal, typical=V_pop, sd=omega_V}
ka = {distribution=logNormal, typical=ka_pop, sd=omega_ka}

[LONGITUDINAL]
input = {b}

file = 'lib:oral1_1cpt_kaVCl.txt'

DEFINITION:
DV = {distribution=normal, prediction=Cc, errorModel=proportional(b)}

<FIT>
data = DV
model = DV

<PARAMETER>
Cl_pop = {value=2.71828, method=MLE}
omega_Cl = {value=0.447214, method=MLE}
V_pop = {value=54.5982, method=MLE}
omega_V = {value=0.447214, method=MLE}
ka_pop = {value=1.10517, method=MLE}
omega_ka = {value=0.447214, method=MLE}
b = {value=0.2, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMode })
fim(method = StochasticApproximation)
logLikelihood(method = ImportanceSampling)

[SETTINGS]
GLOBAL:
exportpath = 'out'
