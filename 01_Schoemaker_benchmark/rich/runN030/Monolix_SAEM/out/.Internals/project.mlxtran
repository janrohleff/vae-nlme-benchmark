<DATAFILE>

[FILEINFO]
file={path='../../../../../data/rich/Oral_1CPTMM_md.csv'}
delimiter = comma
header={ID, TIME, DV, LNDV, MDV, AMT, EVID, DOSE, V, VM, KM, KA, SD, CMT}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
DV = {use=observation, type=continuous}
MDV = {use=missingdependentvariable}
AMT = {use=amount}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {Vm_pop, omega_Vm, Km_pop, omega_Km, V_pop, omega_V, ka_pop, omega_ka}

DEFINITION:
Vm = {distribution=logNormal, typical=Vm_pop, sd=omega_Vm}
Km = {distribution=logNormal, typical=Km_pop, sd=omega_Km}
V = {distribution=logNormal, typical=V_pop, sd=omega_V}
ka = {distribution=logNormal, typical=ka_pop, sd=omega_ka}

[LONGITUDINAL]
input = {b}

file = 'lib:oral1_1cpt_kaVVmKm.txt'

DEFINITION:
DV = {distribution=normal, prediction=Cc, errorModel=proportional(b)}

<FIT>
data = 'DV'
model = DV

<PARAMETER>
Km_pop = {value=298.867, method=MLE}
V_pop = {value=90.0171, method=MLE}
Vm_pop = {value=1096.63, method=MLE}
b = {value=0.3, method=MLE}
c = {value=1, method=FIXED}
ka_pop = {value=1.2214, method=MLE}
omega_Km = {value=0.387298, method=MLE}
omega_V = {value=0.387298, method=MLE}
omega_Vm = {value=0.387298, method=MLE}
omega_ka = {value=0.387298, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = conditionalMode)
fim(method = StochasticApproximation)
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = false
plots = {}

[SETTINGS]
GLOBAL:
exportpath = '../'

