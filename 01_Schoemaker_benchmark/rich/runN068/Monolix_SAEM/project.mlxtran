<DATAFILE>

[FILEINFO]
file = 'Oral_2CPTMM_sd.csv'
delimiter = comma
header = {ID, TIME, DV, LNDV, MDV, AMT, EVID, DOSE, V1, VM, KM, Q, V2, KA, SD, CMT}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
DV = {use=observation, name=DV, type=continuous}
MDV = {use=missingdependentvariable}
AMT = {use=amount}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {Vm_pop, omega_Vm, Km_pop, omega_Km, V1_pop, omega_V1, Q_pop, omega_Q, V2_pop, omega_V2, ka_pop, omega_ka}

DEFINITION:
Vm = {distribution=logNormal, typical=Vm_pop, sd=omega_Vm}
Km = {distribution=logNormal, typical=Km_pop, sd=omega_Km}
V1 = {distribution=logNormal, typical=V1_pop, sd=omega_V1}
Q = {distribution=logNormal, typical=Q_pop, sd=omega_Q}
V2 = {distribution=logNormal, typical=V2_pop, sd=omega_V2}
ka = {distribution=logNormal, typical=ka_pop, sd=omega_ka}

[LONGITUDINAL]
input = {b}

file = 'lib:oral1_2cpt_kaV1QV2VmKm.txt'

DEFINITION:
DV = {distribution=normal, prediction=Cc, errorModel=proportional(b)}

<FIT>
data = DV
model = DV

<PARAMETER>
Vm_pop = {value=1211.97, method=MLE}
omega_Vm = {value=0.387298, method=MLE}
Km_pop = {value=298.867, method=MLE}
omega_Km = {value=0.387298, method=MLE}
V1_pop = {value=90.0171, method=MLE}
omega_V1 = {value=0.387298, method=MLE}
Q_pop = {value=4.95303, method=MLE}
omega_Q = {value=0.387298, method=MLE}
V2_pop = {value=60.3403, method=MLE}
omega_V2 = {value=0.387298, method=MLE}
ka_pop = {value=1.24608, method=MLE}
omega_ka = {value=0.387298, method=MLE}
b = {value=0.3, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMode })
fim(method = StochasticApproximation)
logLikelihood(method = ImportanceSampling)

[SETTINGS]
GLOBAL:
exportpath = 'out'
