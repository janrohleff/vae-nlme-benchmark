<DATAFILE>

[FILEINFO]
file = 'Bolus_1CPTMM_md.csv'
delimiter = comma
header = {ID, TIME, DV, LNDV, MDV, AMT, EVID, DOSE, V, VM, KM, SD, CMT}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
DV = {use=observation, name=DV, type=continuous}
MDV = {use=missingdependentvariable}
AMT = {use=amount}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {Vm_pop, omega_Vm, Km_pop, omega_Km, V_pop, omega_V}

DEFINITION:
Vm = {distribution=logNormal, typical=Vm_pop, sd=omega_Vm}
Km = {distribution=logNormal, typical=Km_pop, sd=omega_Km}
V = {distribution=logNormal, typical=V_pop, sd=omega_V}

[LONGITUDINAL]
input = {b}

file = 'lib:bolus_1cpt_VVmKm.txt'

DEFINITION:
DV = {distribution=normal, prediction=Cc, errorModel=proportional(b)}

<FIT>
data = DV
model = DV

<PARAMETER>
Vm_pop = {value=992.275, method=MLE}
omega_Vm = {value=0.316228, method=MLE}
Km_pop = {value=330.3, method=MLE}
omega_Km = {value=0.374166, method=MLE}
V_pop = {value=66.6863, method=MLE}
omega_V = {value=0.316228, method=MLE}
b = {value=0.2, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMode })
fim(method = StochasticApproximation)
logLikelihood(method = ImportanceSampling)

[SETTINGS]
GLOBAL:
exportpath = 'out'
