<DATAFILE>

[FILEINFO]
file={path='../../../data.csv'}
delimiter = comma
header={ID, TIME, AMT, DV, MDV, EVID, FEAT0001, FEAT0002, FEAT0003, FEAT0004, FEAT0005, FEAT0006, FEAT0007, FEAT0008, FEAT0009, FEAT0010, FEAT0011, FEAT0012, FEAT0013, FEAT0014, FEAT0015, FEAT0016, FEAT0017, FEAT0018, FEAT0019, FEAT0020, FEAT0021, FEAT0022, FEAT0023, FEAT0024, FEAT0025, FEAT0026, FEAT0027, FEAT0028, FEAT0029, FEAT0030, FEAT0031, FEAT0032, FEAT0033, FEAT0034, FEAT0035, FEAT0036, FEAT0037, FEAT0038, FEAT0039, FEAT0040, FEAT0041, FEAT0042, FEAT0043, FEAT0044, FEAT0045, FEAT0046, FEAT0047, FEAT0048, FEAT0049, FEAT0050, FEAT0051, FEAT0052, FEAT0053, FEAT0054, FEAT0055, FEAT0056, FEAT0057, FEAT0058, FEAT0059, FEAT0060, FEAT0061, FEAT0062, FEAT0063, FEAT0064}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, type=continuous}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}
FEAT0001 = {use=covariate, type=continuous}
FEAT0002 = {use=covariate, type=continuous}
FEAT0003 = {use=covariate, type=continuous}
FEAT0004 = {use=covariate, type=continuous}
FEAT0005 = {use=covariate, type=continuous}
FEAT0006 = {use=covariate, type=continuous}
FEAT0007 = {use=covariate, type=continuous}
FEAT0008 = {use=covariate, type=continuous}
FEAT0009 = {use=covariate, type=continuous}
FEAT0010 = {use=covariate, type=continuous}
FEAT0011 = {use=covariate, type=continuous}
FEAT0012 = {use=covariate, type=continuous}
FEAT0013 = {use=covariate, type=continuous}
FEAT0014 = {use=covariate, type=continuous}
FEAT0015 = {use=covariate, type=continuous}
FEAT0016 = {use=covariate, type=continuous}
FEAT0017 = {use=covariate, type=continuous}
FEAT0018 = {use=covariate, type=continuous}
FEAT0019 = {use=covariate, type=continuous}
FEAT0020 = {use=covariate, type=continuous}
FEAT0021 = {use=covariate, type=continuous}
FEAT0022 = {use=covariate, type=continuous}
FEAT0023 = {use=covariate, type=continuous}
FEAT0024 = {use=covariate, type=continuous}
FEAT0025 = {use=covariate, type=continuous}
FEAT0026 = {use=covariate, type=continuous}
FEAT0027 = {use=covariate, type=continuous}
FEAT0028 = {use=covariate, type=continuous}
FEAT0029 = {use=covariate, type=continuous}
FEAT0030 = {use=covariate, type=continuous}
FEAT0031 = {use=covariate, type=continuous}
FEAT0032 = {use=covariate, type=continuous}
FEAT0033 = {use=covariate, type=continuous}
FEAT0034 = {use=covariate, type=continuous}
FEAT0035 = {use=covariate, type=continuous}
FEAT0036 = {use=covariate, type=continuous}
FEAT0037 = {use=covariate, type=continuous}
FEAT0038 = {use=covariate, type=continuous}
FEAT0039 = {use=covariate, type=continuous}
FEAT0040 = {use=covariate, type=continuous}
FEAT0041 = {use=covariate, type=continuous}
FEAT0042 = {use=covariate, type=continuous}
FEAT0043 = {use=covariate, type=continuous}
FEAT0044 = {use=covariate, type=continuous}
FEAT0045 = {use=covariate, type=continuous}
FEAT0046 = {use=covariate, type=continuous}
FEAT0047 = {use=covariate, type=continuous}
FEAT0048 = {use=covariate, type=continuous}
FEAT0049 = {use=covariate, type=continuous}
FEAT0050 = {use=covariate, type=continuous}
FEAT0051 = {use=covariate, type=continuous}
FEAT0052 = {use=covariate, type=continuous}
FEAT0053 = {use=covariate, type=continuous}
FEAT0054 = {use=covariate, type=continuous}
FEAT0055 = {use=covariate, type=continuous}
FEAT0056 = {use=covariate, type=continuous}
FEAT0057 = {use=covariate, type=continuous}
FEAT0058 = {use=covariate, type=continuous}
FEAT0059 = {use=covariate, type=continuous}
FEAT0060 = {use=covariate, type=continuous}
FEAT0061 = {use=covariate, type=continuous}
FEAT0062 = {use=covariate, type=continuous}
FEAT0063 = {use=covariate, type=continuous}
FEAT0064 = {use=covariate, type=continuous}

<MODEL>

[COVARIATE]
input = {FEAT0001, FEAT0002, FEAT0003, FEAT0004, FEAT0005, FEAT0006, FEAT0007, FEAT0008, FEAT0009, FEAT0010, FEAT0011, FEAT0012, FEAT0013, FEAT0014, FEAT0015, FEAT0016, FEAT0017, FEAT0018, FEAT0019, FEAT0020, FEAT0021, FEAT0022, FEAT0023, FEAT0024, FEAT0025, FEAT0026, FEAT0027, FEAT0028, FEAT0029, FEAT0030, FEAT0031, FEAT0032, FEAT0033, FEAT0034, FEAT0035, FEAT0036, FEAT0037, FEAT0038, FEAT0039, FEAT0040, FEAT0041, FEAT0042, FEAT0043, FEAT0044, FEAT0045, FEAT0046, FEAT0047, FEAT0048, FEAT0049, FEAT0050, FEAT0051, FEAT0052, FEAT0053, FEAT0054, FEAT0055, FEAT0056, FEAT0057, FEAT0058, FEAT0059, FEAT0060, FEAT0061, FEAT0062, FEAT0063, FEAT0064}

[INDIVIDUAL]
input = {kel_pop, V_pop, R0_pop, kout_pop, omega_kout, Imax_pop, IC50_pop, omega_IC50}

DEFINITION:
kel = {distribution=logNormal, typical=kel_pop, no-variability}
V = {distribution=logNormal, typical=V_pop, no-variability}
R0 = {distribution=logNormal, typical=R0_pop, no-variability}
kout = {distribution=logNormal, typical=kout_pop, sd=omega_kout}
Imax = {distribution=logNormal, typical=Imax_pop, no-variability}
IC50 = {distribution=logNormal, typical=IC50_pop, sd=omega_IC50}

[LONGITUDINAL]
input = {b}

file = '../../../model.txt'

DEFINITION:
DV = {distribution=normal, prediction=R, errorModel=proportional(b)}

<FIT>
data = 'DV'
model = DV

<PARAMETER>
IC50_pop = {value=5, method=MLE}
Imax_pop = {value=0.9, method=FIXED}
R0_pop = {value=100, method=MLE}
V_pop = {value=10, method=FIXED}
b = {value=0.3, method=MLE}
c = {value=1, method=FIXED}
kel_pop = {value=0.1, method=FIXED}
kout_pop = {value=1, method=MLE}
omega_IC50 = {value=1, method=MLE}
omega_kout = {value=1, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = conditionalMode)
fim(run = false,method = none )
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = false
plots = {}

[SETTINGS]
GLOBAL:
exportpath = '../../'

