<MODEL>

[COVARIATE]
input = {FEAT0001, FEAT0002, FEAT0003, FEAT0004, FEAT0005, FEAT0006, FEAT0007, FEAT0008, FEAT0009, FEAT0010, FEAT0011, FEAT0012, FEAT0013, FEAT0014, FEAT0015, FEAT0016, FEAT0017, FEAT0018, FEAT0019, FEAT0020, FEAT0021, FEAT0022, FEAT0023, FEAT0024, FEAT0025, FEAT0026, FEAT0027, FEAT0028, FEAT0029, FEAT0030, FEAT0031, FEAT0032, FEAT0033, FEAT0034, FEAT0035, FEAT0036, FEAT0037, FEAT0038, FEAT0039, FEAT0040, FEAT0041, FEAT0042, FEAT0043, FEAT0044, FEAT0045, FEAT0046, FEAT0047, FEAT0048, FEAT0049, FEAT0050, FEAT0051, FEAT0052, FEAT0053, FEAT0054, FEAT0055, FEAT0056, FEAT0057, FEAT0058, FEAT0059, FEAT0060, FEAT0061, FEAT0062, FEAT0063, FEAT0064, FEAT0065, FEAT0066, FEAT0067, FEAT0068, FEAT0069, FEAT0070, FEAT0071, FEAT0072, FEAT0073, FEAT0074, FEAT0075, FEAT0076, FEAT0077, FEAT0078, FEAT0079, FEAT0080, FEAT0081, FEAT0082, FEAT0083, FEAT0084, FEAT0085, FEAT0086, FEAT0087, FEAT0088, FEAT0089, FEAT0090, FEAT0091, FEAT0092, FEAT0093, FEAT0094, FEAT0095, FEAT0096, FEAT0097, FEAT0098, FEAT0099, FEAT0100, FEAT0101, FEAT0102, FEAT0103, FEAT0104, FEAT0105, FEAT0106, FEAT0107, FEAT0108, FEAT0109, FEAT0110, FEAT0111, FEAT0112, FEAT0113, FEAT0114, FEAT0115, FEAT0116, FEAT0117, FEAT0118, FEAT0119, FEAT0120, FEAT0121, FEAT0122, FEAT0123, FEAT0124, FEAT0125, FEAT0126, FEAT0127, FEAT0128}

[INDIVIDUAL]
input = {kel_pop, V_pop, R0_pop, kout_pop, omega_kout, Imax_pop, IC50_pop, omega_IC50}

DEFINITION:
kel = {distribution=logNormal, typical=kel_pop, no-variability}
V = {distribution=logNormal, typical=V_pop, no-variability}
R0 = {distribution=logNormal, typical=R0_pop, no-variability}
kout = {distribution=logNormal, typical=kout_pop, sd=omega_kout}
Imax = {distribution=logNormal, typical=Imax_pop, no-variability}
IC50 = {distribution=logNormal, typical=IC50_pop, sd=omega_IC50}

[LONGITUDINAL]
input = {b}

file = '../../../model.txt'

DEFINITION:
DV = {distribution=normal, prediction=R, errorModel=proportional(b)}

<FIT>
data = 'DV'
model = DV

<PARAMETER>
IC50_pop = {value=5, method=MLE}
Imax_pop = {value=0.9, method=FIXED}
R0_pop = {value=100, method=MLE}
V_pop = {value=10, method=FIXED}
b = {value=0.3, method=MLE}
c = {value=1, method=FIXED}
kel_pop = {value=0.1, method=FIXED}
kout_pop = {value=1, method=MLE}
omega_IC50 = {value=1, method=MLE}
omega_kout = {value=1, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = conditionalMode)
fim(run = false,method = none )
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = false
plots = {}

[SETTINGS]
GLOBAL:
exportpath = '../../'

