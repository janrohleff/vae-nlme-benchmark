<DATAFILE>

[FILEINFO]
file={path='../../../data.csv'}
delimiter = comma
header={ID, TIME, AMT, DV, MDV, EVID, FEAT0001, FEAT0002, FEAT0003, FEAT0004, FEAT0005, FEAT0006, FEAT0007, FEAT0008, FEAT0009, FEAT0010, FEAT0011, FEAT0012, FEAT0013, FEAT0014, FEAT0015, FEAT0016, FEAT0017, FEAT0018, FEAT0019, FEAT0020, FEAT0021, FEAT0022, FEAT0023, FEAT0024, FEAT0025, FEAT0026, FEAT0027, FEAT0028, FEAT0029, FEAT0030, FEAT0031, FEAT0032}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, type=continuous}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}
FEAT0001 = {use=covariate, type=continuous}
FEAT0002 = {use=covariate, type=continuous}
FEAT0003 = {use=covariate, type=continuous}
FEAT0004 = {use=covariate, type=continuous}
FEAT0005 = {use=covariate, type=continuous}
FEAT0006 = {use=covariate, type=continuous}
FEAT0007 = {use=covariate, type=continuous}
FEAT0008 = {use=covariate, type=continuous}
FEAT0009 = {use=covariate, type=continuous}
FEAT0010 = {use=covariate, type=continuous}
FEAT0011 = {use=covariate, type=continuous}
FEAT0012 = {use=covariate, type=continuous}
FEAT0013 = {use=covariate, type=continuous}
FEAT0014 = {use=covariate, type=continuous}
FEAT0015 = {use=covariate, type=continuous}
FEAT0016 = {use=covariate, type=continuous}
FEAT0017 = {use=covariate, type=continuous}
FEAT0018 = {use=covariate, type=continuous}
FEAT0019 = {use=covariate, type=continuous}
FEAT0020 = {use=covariate, type=continuous}
FEAT0021 = {use=covariate, type=continuous}
FEAT0022 = {use=covariate, type=continuous}
FEAT0023 = {use=covariate, type=continuous}
FEAT0024 = {use=covariate, type=continuous}
FEAT0025 = {use=covariate, type=continuous}
FEAT0026 = {use=covariate, type=continuous}
FEAT0027 = {use=covariate, type=continuous}
FEAT0028 = {use=covariate, type=continuous}
FEAT0029 = {use=covariate, type=continuous}
FEAT0030 = {use=covariate, type=continuous}
FEAT0031 = {use=covariate, type=continuous}
FEAT0032 = {use=covariate, type=continuous}

<MODEL>

[COVARIATE]
input = {FEAT0001, FEAT0002, FEAT0003, FEAT0004, FEAT0005, FEAT0006, FEAT0007, FEAT0008, FEAT0009, FEAT0010, FEAT0011, FEAT0012, FEAT0013, FEAT0014, FEAT0015, FEAT0016, FEAT0017, FEAT0018, FEAT0019, FEAT0020, FEAT0021, FEAT0022, FEAT0023, FEAT0024, FEAT0025, FEAT0026, FEAT0027, FEAT0028, FEAT0029, FEAT0030, FEAT0031, FEAT0032}

[INDIVIDUAL]
input = {kel_pop, V_pop, R0_pop, kout_pop, omega_kout, Imax_pop, IC50_pop, omega_IC50}

DEFINITION:
kel = {distribution=logNormal, typical=kel_pop, no-variability}
V = {distribution=logNormal, typical=V_pop, no-variability}
R0 = {distribution=logNormal, typical=R0_pop, no-variability}
kout = {distribution=logNormal, typical=kout_pop, sd=omega_kout}
Imax = {distribution=logNormal, typical=Imax_pop, no-variability}
IC50 = {distribution=logNormal, typical=IC50_pop, sd=omega_IC50}

[LONGITUDINAL]
input = {b}

file = '../../../model.txt'

DEFINITION:
DV = {distribution=normal, prediction=R, errorModel=proportional(b)}

<FIT>
data = 'DV'
model = DV

<PARAMETER>
IC50_pop = {value=5, method=MLE}
Imax_pop = {value=0.9, method=FIXED}
R0_pop = {value=100, method=MLE}
V_pop = {value=10, method=FIXED}
b = {value=0.3, method=MLE}
c = {value=1, method=FIXED}
kel_pop = {value=0.1, method=FIXED}
kout_pop = {value=1, method=MLE}
omega_IC50 = {value=1, method=MLE}
omega_kout = {value=1, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = conditionalMean)
fim(run = false,method = StochasticApproximation)
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = false
plots = {}

[SETTINGS]
GLOBAL:
exportpath = '../../'

