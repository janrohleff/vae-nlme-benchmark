<DATAFILE>

[FILEINFO]
file = 'data.csv'
delimiter = comma
header = {ID, TIME, AMT, DV, YTYPE, MDV, EVID}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, yname={'1', '2'}, type={continuous, continuous}}
YTYPE = {use=observationtype}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {ka_pop, omega_ka, V_pop, omega_V, Cl_pop, omega_Cl, R0_pop, omega_R0, kout_pop, omega_kout, wcos_1_pop, wsin_1_pop, wc_1_pop, bh_1_pop, wo_1_pop, wcos_2_pop, wsin_2_pop, wc_2_pop, bh_2_pop, wo_2_pop}

DEFINITION:
ka = {distribution=logNormal, typical=ka_pop, sd=omega_ka}
V = {distribution=logNormal, typical=V_pop, sd=omega_V}
Cl = {distribution=logNormal, typical=Cl_pop, sd=omega_Cl}
R0 = {distribution=logNormal, typical=R0_pop, sd=omega_R0}
kout = {distribution=logNormal, typical=kout_pop, sd=omega_kout}
wcos_1 = {distribution=normal, typical=wcos_1_pop, no-variability}
wsin_1 = {distribution=normal, typical=wsin_1_pop, no-variability}
wc_1 = {distribution=normal, typical=wc_1_pop, no-variability}
bh_1 = {distribution=normal, typical=bh_1_pop, no-variability}
wo_1 = {distribution=normal, typical=wo_1_pop, no-variability}
wcos_2 = {distribution=normal, typical=wcos_2_pop, no-variability}
wsin_2 = {distribution=normal, typical=wsin_2_pop, no-variability}
wc_2 = {distribution=normal, typical=wc_2_pop, no-variability}
bh_2 = {distribution=normal, typical=bh_2_pop, no-variability}
wo_2 = {distribution=normal, typical=wo_2_pop, no-variability}

[LONGITUDINAL]
input = {b1, b2}

file = 'model.txt'

DEFINITION:
y1 = {distribution=normal, prediction=Cc, errorModel=proportional(b1)}
y2 = {distribution=normal, prediction=R, errorModel=proportional(b2)}

<FIT>
data = {'1', '2'}
model = {y1, y2}

<PARAMETER>
Cl_pop = {value=2.8, method=MLE}
R0_pop = {value=90, method=MLE}
V_pop = {value=70, method=MLE}
b1 = {value=0.3, method=MLE}
b2 = {value=0.3, method=MLE}
bh_1_pop = {value=0.11757139, method=MLE}
bh_2_pop = {value=-0.52658445, method=MLE}
ka_pop = {value=0.6, method=MLE}
kout_pop = {value=0.9, method=MLE}
omega_Cl = {value=0.5, method=MLE}
omega_R0 = {value=0.5, method=MLE}
omega_V = {value=0.5, method=MLE}
omega_ka = {value=0.5, method=MLE}
omega_kout = {value=0.5, method=MLE}
wc_1_pop = {value=0.20166805, method=MLE}
wc_2_pop = {value=0.35557407, method=MLE}
wcos_1_pop = {value=-0.53020549, method=MLE}
wcos_2_pop = {value=-0.54682642, method=MLE}
wo_1_pop = {value=-0.29022774, method=MLE}
wo_2_pop = {value=-0.40704751, method=MLE}
wsin_1_pop = {value=-0.39852327, method=MLE}
wsin_2_pop = {value=-0.47306418, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMode })
logLikelihood(method = ImportanceSampling)

[SETTINGS]
GLOBAL:
exportpath = 'out'
