$PROBLEM circadian IDR with neural network | H = 4 | FOCEI
$ABBR DERIV2=NO
$INPUT ID TIME AMT DV MDV EVID CMT DVID
$DATA data.csv IGNORE=@
$SUBROUTINES ADVAN13 TOL=tolswitch.f90
$MODEL COMP=(DEPOT,DEFDOSE) COMP=(CENTRAL,DEFOBS) COMP=(RESP)

$PK
; classical parameters: MU referencing, IIV log-normal; network weights: fixed effects without IIV
MU_1 = LOG(THETA(1))
KA = EXP(MU_1 + ETA(1))
MU_2 = LOG(THETA(2))
V = EXP(MU_2 + ETA(2))
MU_3 = LOG(THETA(3))
CL = EXP(MU_3 + ETA(3))
MU_4 = LOG(THETA(4))
RBASE = EXP(MU_4 + ETA(4))
MU_5 = LOG(THETA(5))
KOUT = EXP(MU_5 + ETA(5))
A_0(3) = RBASE
WCOS1 = THETA(6)
WSIN1 = THETA(7)
WC1 = THETA(8)
BH1 = THETA(9)
WO1 = THETA(10)
WCOS2 = THETA(11)
WSIN2 = THETA(12)
WC2 = THETA(13)
BH2 = THETA(14)
WO2 = THETA(15)
WCOS3 = THETA(16)
WSIN3 = THETA(17)
WC3 = THETA(18)
BH3 = THETA(19)
WO3 = THETA(20)
WCOS4 = THETA(21)
WSIN4 = THETA(22)
WC4 = THETA(23)
BH4 = THETA(24)
WO4 = THETA(25)
; network at the reference state (midnight, no drug): cos = 1, sin = 0, C = 0
NN0 = 0
Z01 = WCOS1 + BH1
IF (Z01.GT.30) Z01 = 30
IF (Z01.LT.-30) Z01 = -30
NN0 = NN0 + WO1*(2/(1 + EXP(-2*Z01)) - 1)
Z02 = WCOS2 + BH2
IF (Z02.GT.30) Z02 = 30
IF (Z02.LT.-30) Z02 = -30
NN0 = NN0 + WO2*(2/(1 + EXP(-2*Z02)) - 1)
Z03 = WCOS3 + BH3
IF (Z03.GT.30) Z03 = 30
IF (Z03.LT.-30) Z03 = -30
NN0 = NN0 + WO3*(2/(1 + EXP(-2*Z03)) - 1)
Z04 = WCOS4 + BH4
IF (Z04.GT.30) Z04 = 30
IF (Z04.LT.-30) Z04 = -30
NN0 = NN0 + WO4*(2/(1 + EXP(-2*Z04)) - 1)

$DES
CC = A(2)/V
DADT(1) = -KA*A(1)
DADT(2) = KA*A(1) - CL/V*A(2)
CPH = COS(0.2617993877991494*T)
SPH = SIN(0.2617993877991494*T)
XC = CC/2.3
NN = 0
Z1 = WCOS1*CPH + WSIN1*SPH + WC1*XC + BH1
IF (Z1.GT.30) Z1 = 30
IF (Z1.LT.-30) Z1 = -30
NN = NN + WO1*(2/(1 + EXP(-2*Z1)) - 1)
Z2 = WCOS2*CPH + WSIN2*SPH + WC2*XC + BH2
IF (Z2.GT.30) Z2 = 30
IF (Z2.LT.-30) Z2 = -30
NN = NN + WO2*(2/(1 + EXP(-2*Z2)) - 1)
Z3 = WCOS3*CPH + WSIN3*SPH + WC3*XC + BH3
IF (Z3.GT.30) Z3 = 30
IF (Z3.LT.-30) Z3 = -30
NN = NN + WO3*(2/(1 + EXP(-2*Z3)) - 1)
Z4 = WCOS4*CPH + WSIN4*SPH + WC4*XC + BH4
IF (Z4.GT.30) Z4 = 30
IF (Z4.LT.-30) Z4 = -30
NN = NN + WO4*(2/(1 + EXP(-2*Z4)) - 1)
DADT(3) = RBASE*KOUT*(1 + NN - NN0) - KOUT*A(3)

$ERROR
IPRED = A(2)/V
IF (DVID.EQ.2) IPRED = A(3)
Y = IPRED + IPRED*EPS(1)
IF (DVID.EQ.2) Y = IPRED + IPRED*EPS(2)

$THETA
(0, 0.6)   ; 1 ka_pop
(0, 70.0)   ; 2 V_pop
(0, 2.8)   ; 3 Cl_pop
(0, 90.0)   ; 4 R0_pop
(0, 0.9)   ; 5 kout_pop
-0.5302054882   ; 6 wcos_1
0.2016680539   ; 7 wsin_1
-0.2369699627   ; 8 wc_1
-0.01953846216   ; 9 bh_1
-0.02989661694   ; 10 wo_1
-0.5468264222   ; 11 wcos_2
0.3555740714   ; 12 wsin_2
-0.3323529065   ; 13 wc_2
0.4808306098   ; 14 bh_2
-0.2454283237   ; 15 wo_2
-0.3985232711   ; 16 wcos_3
0.1175713912   ; 17 wsin_3
0.1629817039   ; 18 wc_3
0.5260078907   ; 19 bh_3
0.1855988503   ; 20 wo_3
-0.4730641842   ; 21 wcos_4
-0.5265844464   ; 22 wsin_4
0.5136013031   ; 23 wc_4
0.2119407356   ; 24 bh_4
0.1072672606   ; 25 wo_4

$OMEGA
0.25   ; ETA(1) ka
0.25   ; ETA(2) V
0.25   ; ETA(3) Cl
0.25   ; ETA(4) R0
0.25   ; ETA(5) kout

$SIGMA
0.09   ; EPS(1) Conc proportional
0.09   ; EPS(2) Effect proportional

$EST METHOD=COND INTERACTION MAXEVAL=999999 NSIG=2 SIGL=6 PRINT=5 NOABORT
     FORMAT=s1PE17.10
$EST METHOD=IMP INTERACTION EONLY=1 NITER=5 ISAMPLE=1000 DF=5 ISCALE_MIN=1 ISCALE_MAX=1 MAPITER=0
     CTYPE=0 SIGL=3 PRINT=1 SEED=23456 NOCOV=1 FORMAT=s1PE17.10
$EST METHOD=IMP INTERACTION EONLY=1 NITER=1 ISAMPLE=10000 DF=5 ISCALE_MIN=1 ISCALE_MAX=1 MAPITER=0
     CTYPE=0 SIGL=3 PRINT=1 SEED=34567 NOCOV=1 FNLETA=0
