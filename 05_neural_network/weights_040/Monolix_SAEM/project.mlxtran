<DATAFILE>

[FILEINFO]
file = 'data.csv'
delimiter = comma
header = {ID, TIME, AMT, DV, YTYPE, MDV, EVID}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, yname={'1', '2'}, type={continuous, continuous}}
YTYPE = {use=observationtype}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {ka_pop, omega_ka, V_pop, omega_V, Cl_pop, omega_Cl, R0_pop, omega_R0, kout_pop, omega_kout, wcos_1_pop, wsin_1_pop, wc_1_pop, bh_1_pop, wo_1_pop, wcos_2_pop, wsin_2_pop, wc_2_pop, bh_2_pop, wo_2_pop, wcos_3_pop, wsin_3_pop, wc_3_pop, bh_3_pop, wo_3_pop, wcos_4_pop, wsin_4_pop, wc_4_pop, bh_4_pop, wo_4_pop, wcos_5_pop, wsin_5_pop, wc_5_pop, bh_5_pop, wo_5_pop, wcos_6_pop, wsin_6_pop, wc_6_pop, bh_6_pop, wo_6_pop, wcos_7_pop, wsin_7_pop, wc_7_pop, bh_7_pop, wo_7_pop, wcos_8_pop, wsin_8_pop, wc_8_pop, bh_8_pop, wo_8_pop}

DEFINITION:
ka = {distribution=logNormal, typical=ka_pop, sd=omega_ka}
V = {distribution=logNormal, typical=V_pop, sd=omega_V}
Cl = {distribution=logNormal, typical=Cl_pop, sd=omega_Cl}
R0 = {distribution=logNormal, typical=R0_pop, sd=omega_R0}
kout = {distribution=logNormal, typical=kout_pop, sd=omega_kout}
wcos_1 = {distribution=normal, typical=wcos_1_pop, no-variability}
wsin_1 = {distribution=normal, typical=wsin_1_pop, no-variability}
wc_1 = {distribution=normal, typical=wc_1_pop, no-variability}
bh_1 = {distribution=normal, typical=bh_1_pop, no-variability}
wo_1 = {distribution=normal, typical=wo_1_pop, no-variability}
wcos_2 = {distribution=normal, typical=wcos_2_pop, no-variability}
wsin_2 = {distribution=normal, typical=wsin_2_pop, no-variability}
wc_2 = {distribution=normal, typical=wc_2_pop, no-variability}
bh_2 = {distribution=normal, typical=bh_2_pop, no-variability}
wo_2 = {distribution=normal, typical=wo_2_pop, no-variability}
wcos_3 = {distribution=normal, typical=wcos_3_pop, no-variability}
wsin_3 = {distribution=normal, typical=wsin_3_pop, no-variability}
wc_3 = {distribution=normal, typical=wc_3_pop, no-variability}
bh_3 = {distribution=normal, typical=bh_3_pop, no-variability}
wo_3 = {distribution=normal, typical=wo_3_pop, no-variability}
wcos_4 = {distribution=normal, typical=wcos_4_pop, no-variability}
wsin_4 = {distribution=normal, typical=wsin_4_pop, no-variability}
wc_4 = {distribution=normal, typical=wc_4_pop, no-variability}
bh_4 = {distribution=normal, typical=bh_4_pop, no-variability}
wo_4 = {distribution=normal, typical=wo_4_pop, no-variability}
wcos_5 = {distribution=normal, typical=wcos_5_pop, no-variability}
wsin_5 = {distribution=normal, typical=wsin_5_pop, no-variability}
wc_5 = {distribution=normal, typical=wc_5_pop, no-variability}
bh_5 = {distribution=normal, typical=bh_5_pop, no-variability}
wo_5 = {distribution=normal, typical=wo_5_pop, no-variability}
wcos_6 = {distribution=normal, typical=wcos_6_pop, no-variability}
wsin_6 = {distribution=normal, typical=wsin_6_pop, no-variability}
wc_6 = {distribution=normal, typical=wc_6_pop, no-variability}
bh_6 = {distribution=normal, typical=bh_6_pop, no-variability}
wo_6 = {distribution=normal, typical=wo_6_pop, no-variability}
wcos_7 = {distribution=normal, typical=wcos_7_pop, no-variability}
wsin_7 = {distribution=normal, typical=wsin_7_pop, no-variability}
wc_7 = {distribution=normal, typical=wc_7_pop, no-variability}
bh_7 = {distribution=normal, typical=bh_7_pop, no-variability}
wo_7 = {distribution=normal, typical=wo_7_pop, no-variability}
wcos_8 = {distribution=normal, typical=wcos_8_pop, no-variability}
wsin_8 = {distribution=normal, typical=wsin_8_pop, no-variability}
wc_8 = {distribution=normal, typical=wc_8_pop, no-variability}
bh_8 = {distribution=normal, typical=bh_8_pop, no-variability}
wo_8 = {distribution=normal, typical=wo_8_pop, no-variability}

[LONGITUDINAL]
input = {b1, b2}

file = 'model.txt'

DEFINITION:
y1 = {distribution=normal, prediction=Cc, errorModel=proportional(b1)}
y2 = {distribution=normal, prediction=R, errorModel=proportional(b2)}

<FIT>
data = {'1', '2'}
model = {y1, y2}

<PARAMETER>
Cl_pop = {value=2.8, method=MLE}
R0_pop = {value=90, method=MLE}
V_pop = {value=70, method=MLE}
b1 = {value=0.3, method=MLE}
b2 = {value=0.3, method=MLE}
bh_1_pop = {value=-0.1083485, method=MLE}
bh_2_pop = {value=-0.014718267, method=MLE}
bh_3_pop = {value=0.14863111, method=MLE}
bh_4_pop = {value=-0.4967891, method=MLE}
bh_5_pop = {value=0.53191614, method=MLE}
bh_6_pop = {value=0.27440318, method=MLE}
bh_7_pop = {value=0.38446936, method=MLE}
bh_8_pop = {value=0.31411248, method=MLE}
ka_pop = {value=0.6, method=MLE}
kout_pop = {value=0.9, method=MLE}
omega_Cl = {value=0.5, method=MLE}
omega_R0 = {value=0.5, method=MLE}
omega_V = {value=0.5, method=MLE}
omega_ka = {value=0.5, method=MLE}
omega_kout = {value=0.5, method=MLE}
wc_1_pop = {value=0.55829692, method=MLE}
wc_2_pop = {value=-0.024072275, method=MLE}
wc_3_pop = {value=0.16358951, method=MLE}
wc_4_pop = {value=0.1285947, method=MLE}
wc_5_pop = {value=0.070975482, method=MLE}
wc_6_pop = {value=-0.16756997, method=MLE}
wc_7_pop = {value=-0.064542294, method=MLE}
wc_8_pop = {value=-0.45917016, method=MLE}
wcos_1_pop = {value=-0.3396568, method=MLE}
wcos_2_pop = {value=0.063390017, method=MLE}
wcos_3_pop = {value=0.29402164, method=MLE}
wcos_4_pop = {value=-0.30408391, method=MLE}
wcos_5_pop = {value=0.3187176, method=MLE}
wcos_6_pop = {value=0.28745005, method=MLE}
wcos_7_pop = {value=-0.019153383, method=MLE}
wcos_8_pop = {value=0.4149619, method=MLE}
wo_1_pop = {value=0.21013251, method=MLE}
wo_2_pop = {value=-0.11685256, method=MLE}
wo_3_pop = {value=0.14709394, method=MLE}
wo_4_pop = {value=0.10259593, method=MLE}
wo_5_pop = {value=0.34997621, method=MLE}
wo_6_pop = {value=-0.31679648, method=MLE}
wo_7_pop = {value=0.32259047, method=MLE}
wo_8_pop = {value=-0.054204978, method=MLE}
wsin_1_pop = {value=-0.38440633, method=MLE}
wsin_2_pop = {value=-0.49200606, method=MLE}
wsin_3_pop = {value=0.45766091, method=MLE}
wsin_4_pop = {value=-0.27253836, method=MLE}
wsin_5_pop = {value=-0.44671565, method=MLE}
wsin_6_pop = {value=0.47686329, method=MLE}
wsin_7_pop = {value=0.52645153, method=MLE}
wsin_8_pop = {value=0.30920482, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMode })
logLikelihood(method = ImportanceSampling)

[SETTINGS]
GLOBAL:
exportpath = 'out'
