$PROBLEM circadian IDR with neural network | H = 8 | FOCEI
$ABBR DERIV2=NO
$INPUT ID TIME AMT DV MDV EVID CMT DVID
$DATA data.csv IGNORE=@
$SUBROUTINES ADVAN13 TOL=tolswitch.f90
$MODEL COMP=(DEPOT,DEFDOSE) COMP=(CENTRAL,DEFOBS) COMP=(RESP)

$PK
; classical parameters: MU referencing, IIV log-normal; network weights: fixed effects without IIV
MU_1 = LOG(THETA(1))
KA = EXP(MU_1 + ETA(1))
MU_2 = LOG(THETA(2))
V = EXP(MU_2 + ETA(2))
MU_3 = LOG(THETA(3))
CL = EXP(MU_3 + ETA(3))
MU_4 = LOG(THETA(4))
RBASE = EXP(MU_4 + ETA(4))
MU_5 = LOG(THETA(5))
KOUT = EXP(MU_5 + ETA(5))
A_0(3) = RBASE
WCOS1 = THETA(6)
WSIN1 = THETA(7)
WC1 = THETA(8)
BH1 = THETA(9)
WO1 = THETA(10)
WCOS2 = THETA(11)
WSIN2 = THETA(12)
WC2 = THETA(13)
BH2 = THETA(14)
WO2 = THETA(15)
WCOS3 = THETA(16)
WSIN3 = THETA(17)
WC3 = THETA(18)
BH3 = THETA(19)
WO3 = THETA(20)
WCOS4 = THETA(21)
WSIN4 = THETA(22)
WC4 = THETA(23)
BH4 = THETA(24)
WO4 = THETA(25)
WCOS5 = THETA(26)
WSIN5 = THETA(27)
WC5 = THETA(28)
BH5 = THETA(29)
WO5 = THETA(30)
WCOS6 = THETA(31)
WSIN6 = THETA(32)
WC6 = THETA(33)
BH6 = THETA(34)
WO6 = THETA(35)
WCOS7 = THETA(36)
WSIN7 = THETA(37)
WC7 = THETA(38)
BH7 = THETA(39)
WO7 = THETA(40)
WCOS8 = THETA(41)
WSIN8 = THETA(42)
WC8 = THETA(43)
BH8 = THETA(44)
WO8 = THETA(45)
; network at the reference state (midnight, no drug): cos = 1, sin = 0, C = 0
NN0 = 0
Z01 = WCOS1 + BH1
IF (Z01.GT.30) Z01 = 30
IF (Z01.LT.-30) Z01 = -30
NN0 = NN0 + WO1*(2/(1 + EXP(-2*Z01)) - 1)
Z02 = WCOS2 + BH2
IF (Z02.GT.30) Z02 = 30
IF (Z02.LT.-30) Z02 = -30
NN0 = NN0 + WO2*(2/(1 + EXP(-2*Z02)) - 1)
Z03 = WCOS3 + BH3
IF (Z03.GT.30) Z03 = 30
IF (Z03.LT.-30) Z03 = -30
NN0 = NN0 + WO3*(2/(1 + EXP(-2*Z03)) - 1)
Z04 = WCOS4 + BH4
IF (Z04.GT.30) Z04 = 30
IF (Z04.LT.-30) Z04 = -30
NN0 = NN0 + WO4*(2/(1 + EXP(-2*Z04)) - 1)
Z05 = WCOS5 + BH5
IF (Z05.GT.30) Z05 = 30
IF (Z05.LT.-30) Z05 = -30
NN0 = NN0 + WO5*(2/(1 + EXP(-2*Z05)) - 1)
Z06 = WCOS6 + BH6
IF (Z06.GT.30) Z06 = 30
IF (Z06.LT.-30) Z06 = -30
NN0 = NN0 + WO6*(2/(1 + EXP(-2*Z06)) - 1)
Z07 = WCOS7 + BH7
IF (Z07.GT.30) Z07 = 30
IF (Z07.LT.-30) Z07 = -30
NN0 = NN0 + WO7*(2/(1 + EXP(-2*Z07)) - 1)
Z08 = WCOS8 + BH8
IF (Z08.GT.30) Z08 = 30
IF (Z08.LT.-30) Z08 = -30
NN0 = NN0 + WO8*(2/(1 + EXP(-2*Z08)) - 1)

$DES
CC = A(2)/V
DADT(1) = -KA*A(1)
DADT(2) = KA*A(1) - CL/V*A(2)
CPH = COS(0.2617993877991494*T)
SPH = SIN(0.2617993877991494*T)
XC = CC/2.3
NN = 0
Z1 = WCOS1*CPH + WSIN1*SPH + WC1*XC + BH1
IF (Z1.GT.30) Z1 = 30
IF (Z1.LT.-30) Z1 = -30
NN = NN + WO1*(2/(1 + EXP(-2*Z1)) - 1)
Z2 = WCOS2*CPH + WSIN2*SPH + WC2*XC + BH2
IF (Z2.GT.30) Z2 = 30
IF (Z2.LT.-30) Z2 = -30
NN = NN + WO2*(2/(1 + EXP(-2*Z2)) - 1)
Z3 = WCOS3*CPH + WSIN3*SPH + WC3*XC + BH3
IF (Z3.GT.30) Z3 = 30
IF (Z3.LT.-30) Z3 = -30
NN = NN + WO3*(2/(1 + EXP(-2*Z3)) - 1)
Z4 = WCOS4*CPH + WSIN4*SPH + WC4*XC + BH4
IF (Z4.GT.30) Z4 = 30
IF (Z4.LT.-30) Z4 = -30
NN = NN + WO4*(2/(1 + EXP(-2*Z4)) - 1)
Z5 = WCOS5*CPH + WSIN5*SPH + WC5*XC + BH5
IF (Z5.GT.30) Z5 = 30
IF (Z5.LT.-30) Z5 = -30
NN = NN + WO5*(2/(1 + EXP(-2*Z5)) - 1)
Z6 = WCOS6*CPH + WSIN6*SPH + WC6*XC + BH6
IF (Z6.GT.30) Z6 = 30
IF (Z6.LT.-30) Z6 = -30
NN = NN + WO6*(2/(1 + EXP(-2*Z6)) - 1)
Z7 = WCOS7*CPH + WSIN7*SPH + WC7*XC + BH7
IF (Z7.GT.30) Z7 = 30
IF (Z7.LT.-30) Z7 = -30
NN = NN + WO7*(2/(1 + EXP(-2*Z7)) - 1)
Z8 = WCOS8*CPH + WSIN8*SPH + WC8*XC + BH8
IF (Z8.GT.30) Z8 = 30
IF (Z8.LT.-30) Z8 = -30
NN = NN + WO8*(2/(1 + EXP(-2*Z8)) - 1)
DADT(3) = RBASE*KOUT*(1 + NN - NN0) - KOUT*A(3)

$ERROR
IPRED = A(2)/V
IF (DVID.EQ.2) IPRED = A(3)
Y = IPRED + IPRED*EPS(1)
IF (DVID.EQ.2) Y = IPRED + IPRED*EPS(2)

$THETA
(0, 0.6)   ; 1 ka_pop
(0, 70.0)   ; 2 V_pop
(0, 2.8)   ; 3 Cl_pop
(0, 90.0)   ; 4 R0_pop
(0, 0.9)   ; 5 kout_pop
-0.3396568   ; 6 wcos_1
-0.3844063282   ; 7 wsin_1
0.5582969189   ; 8 wc_1
-0.1083484963   ; 9 bh_1
0.2101325095   ; 10 wo_1
0.06339001656   ; 11 wcos_2
-0.4920060635   ; 12 wsin_2
-0.02407227457   ; 13 wc_2
-0.01471826714   ; 14 bh_2
-0.1168525591   ; 15 wo_2
0.2940216362   ; 16 wcos_3
0.4576609135   ; 17 wsin_3
0.1635895073   ; 18 wc_3
0.1486311108   ; 19 bh_3
0.1470939368   ; 20 wo_3
-0.3040839136   ; 21 wcos_4
-0.2725383639   ; 22 wsin_4
0.1285946965   ; 23 wc_4
-0.4967890978   ; 24 bh_4
0.1025959253   ; 25 wo_4
0.3187175989   ; 26 wcos_5
-0.4467156529   ; 27 wsin_5
0.07097548246   ; 28 wc_5
0.5319161415   ; 29 bh_5
0.3499762118   ; 30 wo_5
0.2874500453   ; 31 wcos_6
0.4768632948   ; 32 wsin_6
-0.1675699651   ; 33 wc_6
0.2744031847   ; 34 bh_6
-0.3167964816   ; 35 wo_6
-0.01915338263   ; 36 wcos_7
0.5264515281   ; 37 wsin_7
-0.06454229355   ; 38 wc_7
0.3844693601   ; 39 bh_7
0.3225904703   ; 40 wo_7
0.4149619043   ; 41 wcos_8
0.3092048168   ; 42 wsin_8
-0.4591701627   ; 43 wc_8
0.3141124845   ; 44 bh_8
-0.05420497805   ; 45 wo_8

$OMEGA
0.25   ; ETA(1) ka
0.25   ; ETA(2) V
0.25   ; ETA(3) Cl
0.25   ; ETA(4) R0
0.25   ; ETA(5) kout

$SIGMA
0.09   ; EPS(1) Conc proportional
0.09   ; EPS(2) Effect proportional

$EST METHOD=COND INTERACTION MAXEVAL=9999 NSIG=2 SIGL=6 PRINT=5 NOABORT
     FORMAT=s1PE17.10
$EST METHOD=IMP INTERACTION EONLY=1 NITER=5 ISAMPLE=1000 DF=5 ISCALE_MIN=1 ISCALE_MAX=1 MAPITER=0
     CTYPE=0 SIGL=3 PRINT=1 SEED=23456 NOCOV=1 FORMAT=s1PE17.10
$EST METHOD=IMP INTERACTION EONLY=1 NITER=1 ISAMPLE=10000 DF=5 ISCALE_MIN=1 ISCALE_MAX=1 MAPITER=0
     CTYPE=0 SIGL=3 PRINT=1 SEED=34567 NOCOV=1 FNLETA=0
