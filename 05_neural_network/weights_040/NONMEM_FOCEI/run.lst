-0.1675699651   ; 33 wc_6
0.2744031847   ; 34 bh_6
-0.3167964816   ; 35 wo_6
-0.01915338263   ; 36 wcos_7
0.5264515281   ; 37 wsin_7
-0.06454229355   ; 38 wc_7
0.3844693601   ; 39 bh_7
0.3225904703   ; 40 wo_7
0.4149619043   ; 41 wcos_8
0.3092048168   ; 42 wsin_8
-0.4591701627   ; 43 wc_8
0.3141124845   ; 44 bh_8
-0.05420497805   ; 45 wo_8

$OMEGA
0.25   ; ETA(1) ka
0.25   ; ETA(2) V
0.25   ; ETA(3) Cl
0.25   ; ETA(4) R0
0.25   ; ETA(5) kout

$SIGMA
0.09   ; EPS(1) Conc proportional
0.09   ; EPS(2) Effect proportional

$EST METHOD=COND INTERACTION MAXEVAL=9999 NSIG=2 SIGL=6 PRINT=5 NOABORT
     FORMAT=s1PE17.10
$EST METHOD=IMP INTERACTION EONLY=1 NITER=5 ISAMPLE=1000 DF=5 ISCALE_MIN=1 ISCALE_MAX=1 MAPITER=0
     CTYPE=0 SIGL=3 PRINT=1 SEED=23456 NOCOV=1 FORMAT=s1PE17.10
