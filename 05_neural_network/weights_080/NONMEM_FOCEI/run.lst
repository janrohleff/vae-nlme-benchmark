BH9 = THETA(49)
WO9 = THETA(50)
WCOS10 = THETA(51)
WSIN10 = THETA(52)
WC10 = THETA(53)
BH10 = THETA(54)
WO10 = THETA(55)
WCOS11 = THETA(56)
WSIN11 = THETA(57)
WC11 = THETA(58)
BH11 = THETA(59)
WO11 = THETA(60)
WCOS12 = THETA(61)
WSIN12 = THETA(62)
WC12 = THETA(63)
BH12 = THETA(64)
WO12 = THETA(65)
WCOS13 = THETA(66)
WSIN13 = THETA(67)
WC13 = THETA(68)
BH13 = THETA(69)
WO13 = THETA(70)
WCOS14 = THETA(71)
WSIN14 = THETA(72)
WC14 = THETA(73)
BH14 = THETA(74)
WO14 = THETA(75)
WCOS15 = THETA(76)
WSIN15 = THETA(77)
WC15 = THETA(78)
BH15 = THETA(79)
WO15 = THETA(80)
WCOS16 = THETA(81)
WSIN16 = THETA(82)
WC16 = THETA(83)
BH16 = THETA(84)
WO16 = THETA(85)
; network at the reference state (midnight, no drug): cos = 1, sin = 0, C = 0
NN0 = 0
Z01 = WCOS1 + BH1
IF (Z01.GT.30) Z01 = 30
IF (Z01.LT.-30) Z01 = -30
NN0 = NN0 + WO1*(2/(1 + EXP(-2*Z01)) - 1)
Z02 = WCOS2 + BH2
IF (Z02.GT.30) Z02 = 30
IF (Z02.LT.-30) Z02 = -30
NN0 = NN0 + WO2*(2/(1 + EXP(-2*Z02)) - 1)
Z03 = WCOS3 + BH3
IF (Z03.GT.30) Z03 = 30
IF (Z03.LT.-30) Z03 = -30
NN0 = NN0 + WO3*(2/(1 + EXP(-2*Z03)) - 1)
Z04 = WCOS4 + BH4
IF (Z04.GT.30) Z04 = 30
IF (Z04.LT.-30) Z04 = -30
NN0 = NN0 + WO4*(2/(1 + EXP(-2*Z04)) - 1)
Z05 = WCOS5 + BH5
IF (Z05.GT.30) Z05 = 30
IF (Z05.LT.-30) Z05 = -30
NN0 = NN0 + WO5*(2/(1 + EXP(-2*Z05)) - 1)
Z06 = WCOS6 + BH6
IF (Z06.GT.30) Z06 = 30
IF (Z06.LT.-30) Z06 = -30
NN0 = NN0 + WO6*(2/(1 + EXP(-2*Z06)) - 1)
Z07 = WCOS7 + BH7
IF (Z07.GT.30) Z07 = 30
IF (Z07.LT.-30) Z07 = -30
NN0 = NN0 + WO7*(2/(1 + EXP(-2*Z07)) - 1)
Z08 = WCOS8 + BH8
IF (Z08.GT.30) Z08 = 30
IF (Z08.LT.-30) Z08 = -30
NN0 = NN0 + WO8*(2/(1 + EXP(-2*Z08)) - 1)
