$SIZES LTH=105 PG=125 DIMNEW=200000
$PROBLEM circadian IDR with neural network | H = 16 | FOCEI
$ABBR DERIV2=NO
$INPUT ID TIME AMT DV MDV EVID CMT DVID
$DATA data.csv IGNORE=@
$SUBROUTINES ADVAN13 TOL=tolswitch.f90
$MODEL COMP=(DEPOT,DEFDOSE) COMP=(CENTRAL,DEFOBS) COMP=(RESP)

$PK
; classical parameters: MU referencing, IIV log-normal; network weights: fixed effects without IIV
MU_1 = LOG(THETA(1))
KA = EXP(MU_1 + ETA(1))
MU_2 = LOG(THETA(2))
V = EXP(MU_2 + ETA(2))
MU_3 = LOG(THETA(3))
CL = EXP(MU_3 + ETA(3))
MU_4 = LOG(THETA(4))
RBASE = EXP(MU_4 + ETA(4))
MU_5 = LOG(THETA(5))
KOUT = EXP(MU_5 + ETA(5))
A_0(3) = RBASE
WCOS1 = THETA(6)
WSIN1 = THETA(7)
WC1 = THETA(8)
BH1 = THETA(9)
WO1 = THETA(10)
WCOS2 = THETA(11)
WSIN2 = THETA(12)
WC2 = THETA(13)
BH2 = THETA(14)
WO2 = THETA(15)
WCOS3 = THETA(16)
WSIN3 = THETA(17)
WC3 = THETA(18)
BH3 = THETA(19)
WO3 = THETA(20)
WCOS4 = THETA(21)
WSIN4 = THETA(22)
WC4 = THETA(23)
BH4 = THETA(24)
WO4 = THETA(25)
WCOS5 = THETA(26)
WSIN5 = THETA(27)
WC5 = THETA(28)
BH5 = THETA(29)
WO5 = THETA(30)
WCOS6 = THETA(31)
WSIN6 = THETA(32)
WC6 = THETA(33)
BH6 = THETA(34)
WO6 = THETA(35)
WCOS7 = THETA(36)
WSIN7 = THETA(37)
WC7 = THETA(38)
BH7 = THETA(39)
WO7 = THETA(40)
WCOS8 = THETA(41)
WSIN8 = THETA(42)
WC8 = THETA(43)
BH8 = THETA(44)
WO8 = THETA(45)
WCOS9 = THETA(46)
WSIN9 = THETA(47)
WC9 = THETA(48)
BH9 = THETA(49)
WO9 = THETA(50)
WCOS10 = THETA(51)
WSIN10 = THETA(52)
WC10 = THETA(53)
BH10 = THETA(54)
WO10 = THETA(55)
WCOS11 = THETA(56)
WSIN11 = THETA(57)
WC11 = THETA(58)
BH11 = THETA(59)
WO11 = THETA(60)
WCOS12 = THETA(61)
WSIN12 = THETA(62)
WC12 = THETA(63)
BH12 = THETA(64)
WO12 = THETA(65)
WCOS13 = THETA(66)
WSIN13 = THETA(67)
WC13 = THETA(68)
BH13 = THETA(69)
WO13 = THETA(70)
WCOS14 = THETA(71)
WSIN14 = THETA(72)
WC14 = THETA(73)
BH14 = THETA(74)
WO14 = THETA(75)
WCOS15 = THETA(76)
WSIN15 = THETA(77)
WC15 = THETA(78)
BH15 = THETA(79)
WO15 = THETA(80)
WCOS16 = THETA(81)
WSIN16 = THETA(82)
WC16 = THETA(83)
BH16 = THETA(84)
WO16 = THETA(85)
; network at the reference state (midnight, no drug): cos = 1, sin = 0, C = 0
NN0 = 0
Z01 = WCOS1 + BH1
IF (Z01.GT.30) Z01 = 30
IF (Z01.LT.-30) Z01 = -30
NN0 = NN0 + WO1*(2/(1 + EXP(-2*Z01)) - 1)
Z02 = WCOS2 + BH2
IF (Z02.GT.30) Z02 = 30
IF (Z02.LT.-30) Z02 = -30
NN0 = NN0 + WO2*(2/(1 + EXP(-2*Z02)) - 1)
Z03 = WCOS3 + BH3
IF (Z03.GT.30) Z03 = 30
IF (Z03.LT.-30) Z03 = -30
NN0 = NN0 + WO3*(2/(1 + EXP(-2*Z03)) - 1)
Z04 = WCOS4 + BH4
IF (Z04.GT.30) Z04 = 30
IF (Z04.LT.-30) Z04 = -30
NN0 = NN0 + WO4*(2/(1 + EXP(-2*Z04)) - 1)
Z05 = WCOS5 + BH5
IF (Z05.GT.30) Z05 = 30
IF (Z05.LT.-30) Z05 = -30
NN0 = NN0 + WO5*(2/(1 + EXP(-2*Z05)) - 1)
Z06 = WCOS6 + BH6
IF (Z06.GT.30) Z06 = 30
IF (Z06.LT.-30) Z06 = -30
NN0 = NN0 + WO6*(2/(1 + EXP(-2*Z06)) - 1)
Z07 = WCOS7 + BH7
IF (Z07.GT.30) Z07 = 30
IF (Z07.LT.-30) Z07 = -30
NN0 = NN0 + WO7*(2/(1 + EXP(-2*Z07)) - 1)
Z08 = WCOS8 + BH8
IF (Z08.GT.30) Z08 = 30
IF (Z08.LT.-30) Z08 = -30
NN0 = NN0 + WO8*(2/(1 + EXP(-2*Z08)) - 1)
Z09 = WCOS9 + BH9
IF (Z09.GT.30) Z09 = 30
IF (Z09.LT.-30) Z09 = -30
NN0 = NN0 + WO9*(2/(1 + EXP(-2*Z09)) - 1)
Z010 = WCOS10 + BH10
IF (Z010.GT.30) Z010 = 30
IF (Z010.LT.-30) Z010 = -30
NN0 = NN0 + WO10*(2/(1 + EXP(-2*Z010)) - 1)
Z011 = WCOS11 + BH11
IF (Z011.GT.30) Z011 = 30
IF (Z011.LT.-30) Z011 = -30
NN0 = NN0 + WO11*(2/(1 + EXP(-2*Z011)) - 1)
Z012 = WCOS12 + BH12
IF (Z012.GT.30) Z012 = 30
IF (Z012.LT.-30) Z012 = -30
NN0 = NN0 + WO12*(2/(1 + EXP(-2*Z012)) - 1)
Z013 = WCOS13 + BH13
IF (Z013.GT.30) Z013 = 30
IF (Z013.LT.-30) Z013 = -30
NN0 = NN0 + WO13*(2/(1 + EXP(-2*Z013)) - 1)
Z014 = WCOS14 + BH14
IF (Z014.GT.30) Z014 = 30
IF (Z014.LT.-30) Z014 = -30
NN0 = NN0 + WO14*(2/(1 + EXP(-2*Z014)) - 1)
Z015 = WCOS15 + BH15
IF (Z015.GT.30) Z015 = 30
IF (Z015.LT.-30) Z015 = -30
NN0 = NN0 + WO15*(2/(1 + EXP(-2*Z015)) - 1)
Z016 = WCOS16 + BH16
IF (Z016.GT.30) Z016 = 30
IF (Z016.LT.-30) Z016 = -30
NN0 = NN0 + WO16*(2/(1 + EXP(-2*Z016)) - 1)

$DES
CC = A(2)/V
DADT(1) = -KA*A(1)
DADT(2) = KA*A(1) - CL/V*A(2)
CPH = COS(0.2617993877991494*T)
SPH = SIN(0.2617993877991494*T)
XC = CC/2.3
NN = 0
Z1 = WCOS1*CPH + WSIN1*SPH + WC1*XC + BH1
IF (Z1.GT.30) Z1 = 30
IF (Z1.LT.-30) Z1 = -30
NN = NN + WO1*(2/(1 + EXP(-2*Z1)) - 1)
Z2 = WCOS2*CPH + WSIN2*SPH + WC2*XC + BH2
IF (Z2.GT.30) Z2 = 30
IF (Z2.LT.-30) Z2 = -30
NN = NN + WO2*(2/(1 + EXP(-2*Z2)) - 1)
Z3 = WCOS3*CPH + WSIN3*SPH + WC3*XC + BH3
IF (Z3.GT.30) Z3 = 30
IF (Z3.LT.-30) Z3 = -30
NN = NN + WO3*(2/(1 + EXP(-2*Z3)) - 1)
Z4 = WCOS4*CPH + WSIN4*SPH + WC4*XC + BH4
IF (Z4.GT.30) Z4 = 30
IF (Z4.LT.-30) Z4 = -30
NN = NN + WO4*(2/(1 + EXP(-2*Z4)) - 1)
Z5 = WCOS5*CPH + WSIN5*SPH + WC5*XC + BH5
IF (Z5.GT.30) Z5 = 30
IF (Z5.LT.-30) Z5 = -30
NN = NN + WO5*(2/(1 + EXP(-2*Z5)) - 1)
Z6 = WCOS6*CPH + WSIN6*SPH + WC6*XC + BH6
IF (Z6.GT.30) Z6 = 30
IF (Z6.LT.-30) Z6 = -30
NN = NN + WO6*(2/(1 + EXP(-2*Z6)) - 1)
Z7 = WCOS7*CPH + WSIN7*SPH + WC7*XC + BH7
IF (Z7.GT.30) Z7 = 30
IF (Z7.LT.-30) Z7 = -30
NN = NN + WO7*(2/(1 + EXP(-2*Z7)) - 1)
Z8 = WCOS8*CPH + WSIN8*SPH + WC8*XC + BH8
IF (Z8.GT.30) Z8 = 30
IF (Z8.LT.-30) Z8 = -30
NN = NN + WO8*(2/(1 + EXP(-2*Z8)) - 1)
Z9 = WCOS9*CPH + WSIN9*SPH + WC9*XC + BH9
IF (Z9.GT.30) Z9 = 30
IF (Z9.LT.-30) Z9 = -30
NN = NN + WO9*(2/(1 + EXP(-2*Z9)) - 1)
Z10 = WCOS10*CPH + WSIN10*SPH + WC10*XC + BH10
IF (Z10.GT.30) Z10 = 30
IF (Z10.LT.-30) Z10 = -30
NN = NN + WO10*(2/(1 + EXP(-2*Z10)) - 1)
Z11 = WCOS11*CPH + WSIN11*SPH + WC11*XC + BH11
IF (Z11.GT.30) Z11 = 30
IF (Z11.LT.-30) Z11 = -30
NN = NN + WO11*(2/(1 + EXP(-2*Z11)) - 1)
Z12 = WCOS12*CPH + WSIN12*SPH + WC12*XC + BH12
IF (Z12.GT.30) Z12 = 30
IF (Z12.LT.-30) Z12 = -30
NN = NN + WO12*(2/(1 + EXP(-2*Z12)) - 1)
Z13 = WCOS13*CPH + WSIN13*SPH + WC13*XC + BH13
IF (Z13.GT.30) Z13 = 30
IF (Z13.LT.-30) Z13 = -30
NN = NN + WO13*(2/(1 + EXP(-2*Z13)) - 1)
Z14 = WCOS14*CPH + WSIN14*SPH + WC14*XC + BH14
IF (Z14.GT.30) Z14 = 30
IF (Z14.LT.-30) Z14 = -30
NN = NN + WO14*(2/(1 + EXP(-2*Z14)) - 1)
Z15 = WCOS15*CPH + WSIN15*SPH + WC15*XC + BH15
IF (Z15.GT.30) Z15 = 30
IF (Z15.LT.-30) Z15 = -30
NN = NN + WO15*(2/(1 + EXP(-2*Z15)) - 1)
Z16 = WCOS16*CPH + WSIN16*SPH + WC16*XC + BH16
IF (Z16.GT.30) Z16 = 30
IF (Z16.LT.-30) Z16 = -30
NN = NN + WO16*(2/(1 + EXP(-2*Z16)) - 1)
DADT(3) = RBASE*KOUT*(1 + NN - NN0) - KOUT*A(3)

$ERROR
IPRED = A(2)/V
IF (DVID.EQ.2) IPRED = A(3)
Y = IPRED + IPRED*EPS(1)
IF (DVID.EQ.2) Y = IPRED + IPRED*EPS(2)

$THETA
