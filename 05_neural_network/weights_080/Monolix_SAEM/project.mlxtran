<DATAFILE>

[FILEINFO]
file = 'data.csv'
delimiter = comma
header = {ID, TIME, AMT, DV, YTYPE, MDV, EVID}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, yname={'1', '2'}, type={continuous, continuous}}
YTYPE = {use=observationtype}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {ka_pop, omega_ka, V_pop, omega_V, Cl_pop, omega_Cl, R0_pop, omega_R0, kout_pop, omega_kout, wcos_1_pop, wsin_1_pop, wc_1_pop, bh_1_pop, wo_1_pop, wcos_2_pop, wsin_2_pop, wc_2_pop, bh_2_pop, wo_2_pop, wcos_3_pop, wsin_3_pop, wc_3_pop, bh_3_pop, wo_3_pop, wcos_4_pop, wsin_4_pop, wc_4_pop, bh_4_pop, wo_4_pop, wcos_5_pop, wsin_5_pop, wc_5_pop, bh_5_pop, wo_5_pop, wcos_6_pop, wsin_6_pop, wc_6_pop, bh_6_pop, wo_6_pop, wcos_7_pop, wsin_7_pop, wc_7_pop, bh_7_pop, wo_7_pop, wcos_8_pop, wsin_8_pop, wc_8_pop, bh_8_pop, wo_8_pop, wcos_9_pop, wsin_9_pop, wc_9_pop, bh_9_pop, wo_9_pop, wcos_10_pop, wsin_10_pop, wc_10_pop, bh_10_pop, wo_10_pop, wcos_11_pop, wsin_11_pop, wc_11_pop, bh_11_pop, wo_11_pop, wcos_12_pop, wsin_12_pop, wc_12_pop, bh_12_pop, wo_12_pop, wcos_13_pop, wsin_13_pop, wc_13_pop, bh_13_pop, wo_13_pop, wcos_14_pop, wsin_14_pop, wc_14_pop, bh_14_pop, wo_14_pop, wcos_15_pop, wsin_15_pop, wc_15_pop, bh_15_pop, wo_15_pop, wcos_16_pop, wsin_16_pop, wc_16_pop, bh_16_pop, wo_16_pop}

DEFINITION:
ka = {distribution=logNormal, typical=ka_pop, sd=omega_ka}
V = {distribution=logNormal, typical=V_pop, sd=omega_V}
Cl = {distribution=logNormal, typical=Cl_pop, sd=omega_Cl}
R0 = {distribution=logNormal, typical=R0_pop, sd=omega_R0}
kout = {distribution=logNormal, typical=kout_pop, sd=omega_kout}
wcos_1 = {distribution=normal, typical=wcos_1_pop, no-variability}
wsin_1 = {distribution=normal, typical=wsin_1_pop, no-variability}
wc_1 = {distribution=normal, typical=wc_1_pop, no-variability}
bh_1 = {distribution=normal, typical=bh_1_pop, no-variability}
wo_1 = {distribution=normal, typical=wo_1_pop, no-variability}
