[LONGITUDINAL]
input = {b1, b2}

file = 'model.txt'

DEFINITION:
y1 = {distribution=normal, prediction=Cc, errorModel=proportional(b1)}
y2 = {distribution=normal, prediction=R, errorModel=proportional(b2)}

<FIT>
data = {'1', '2'}
model = {y1, y2}

