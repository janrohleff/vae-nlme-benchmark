<DATAFILE>

[FILEINFO]
file = 'data.csv'
delimiter = comma
header = {ID, TIME, AMT, DV, MDV, EVID}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, name=DV, type=continuous}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {k_pop, V_pop, lambda0_pop, omega_lambda0, lambda1_pop, omega_lambda1, k1_pop, k2_pop, omega_k2, w0_pop, omega_w0}

DEFINITION:
k = {distribution=logNormal, typical=k_pop, no-variability}
V = {distribution=logNormal, typical=V_pop, no-variability}
lambda0 = {distribution=logNormal, typical=lambda0_pop, sd=omega_lambda0}
lambda1 = {distribution=logNormal, typical=lambda1_pop, sd=omega_lambda1}
k1 = {distribution=logNormal, typical=k1_pop, no-variability}
k2 = {distribution=logNormal, typical=k2_pop, sd=omega_k2}
w0 = {distribution=logNormal, typical=w0_pop, sd=omega_w0}

[LONGITUDINAL]
input = {b}

file = 'model.txt'

DEFINITION:
DV = {distribution=normal, prediction=w, errorModel=proportional(b)}

<FIT>
data = DV
model = DV

<PARAMETER>
V_pop = {value=1, method=FIXED}
b = {value=0.3, method=MLE}
k1_pop = {value=0.6, method=MLE}
k2_pop = {value=0.75, method=MLE}
k_pop = {value=5, method=FIXED}
lambda0_pop = {value=0.175, method=MLE}
lambda1_pop = {value=0.225, method=MLE}
omega_k2 = {value=0.5, method=MLE}
omega_lambda0 = {value=0.5, method=MLE}
omega_lambda1 = {value=0.5, method=MLE}
omega_w0 = {value=0.5, method=MLE}
w0_pop = {value=0.006, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMode })
logLikelihood(method = ImportanceSampling)

[SETTINGS]
GLOBAL:
exportpath = 'out'
