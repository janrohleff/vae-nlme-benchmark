<DATAFILE>

[FILEINFO]
file = 'data.csv'
delimiter = comma
header = {ID, TIME, AMT, DV, MDV, EVID, COV_LLBW, COV_LFM, COV_LAGE, COV_LALP, COV_LDOSE, COV_FASTED, COV_FED, COV_MORNING, SEX, AGE, WT, HT, ALP, DOSE, FOOD, MORNING}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, name=DV, type=continuous}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}
COV_LLBW = {use=covariate, type=continuous}
COV_LFM = {use=covariate, type=continuous}
COV_LAGE = {use=covariate, type=continuous}
COV_LALP = {use=covariate, type=continuous}
COV_LDOSE = {use=covariate, type=continuous}
COV_FASTED = {use=covariate, type=continuous}
COV_FED = {use=covariate, type=continuous}
COV_MORNING = {use=covariate, type=continuous}

<MODEL>

[INDIVIDUAL]
input = {F_pop, omega_F, COV_LDOSE, beta_F_COV_LDOSE, tlag_pop, omega_tlag, COV_FASTED, COV_FED, beta_tlag_COV_FASTED, beta_tlag_COV_FED, ka_pop, omega_ka, COV_MORNING, beta_ka_COV_FASTED, beta_ka_COV_FED, beta_ka_COV_MORNING, Vc_pop, omega_Vc, COV_LLBW, beta_Vc_COV_LLBW, Vp_pop, omega_Vp, COV_LFM, beta_Vp_COV_LFM, Q_pop, omega_Q, beta_Q_COV_LFM, Vm_pop, omega_Vm, Km_pop, omega_Km, COV_LAGE, COV_LALP, beta_Km_COV_LLBW, beta_Km_COV_LAGE, beta_Km_COV_LALP}

DEFINITION:
F = {distribution=logitNormal, typical=F_pop, covariate=COV_LDOSE, coefficient=beta_F_COV_LDOSE, sd=omega_F}
tlag = {distribution=logNormal, typical=tlag_pop, covariate={COV_FASTED, COV_FED}, coefficient={beta_tlag_COV_FASTED, beta_tlag_COV_FED}, sd=omega_tlag}
ka = {distribution=logNormal, typical=ka_pop, covariate={COV_FASTED, COV_FED, COV_MORNING}, coefficient={beta_ka_COV_FASTED, beta_ka_COV_FED, beta_ka_COV_MORNING}, sd=omega_ka}
Vc = {distribution=logNormal, typical=Vc_pop, covariate=COV_LLBW, coefficient=beta_Vc_COV_LLBW, sd=omega_Vc}
Vp = {distribution=logNormal, typical=Vp_pop, covariate=COV_LFM, coefficient=beta_Vp_COV_LFM, sd=omega_Vp}
Q = {distribution=logNormal, typical=Q_pop, covariate=COV_LFM, coefficient=beta_Q_COV_LFM, sd=omega_Q}
Vm = {distribution=logNormal, typical=Vm_pop, sd=omega_Vm}
Km = {distribution=logNormal, typical=Km_pop, covariate={COV_LLBW, COV_LAGE, COV_LALP}, coefficient={beta_Km_COV_LLBW, beta_Km_COV_LAGE, beta_Km_COV_LALP}, sd=omega_Km}

[LONGITUDINAL]
input = {a, b}

file = 'model.txt'

DEFINITION:
DV = {distribution=normal, prediction=C, errorModel=combined1(a, b)}

<FIT>
data = DV
model = DV

<PARAMETER>
F_pop = {value=0.49029543, method=MLE}
Km_pop = {value=3.5382748, method=MLE}
Q_pop = {value=5.0075225, method=MLE}
Vc_pop = {value=20.464648, method=MLE}
Vm_pop = {value=4.8546334, method=MLE}
Vp_pop = {value=9.5717287, method=MLE}
a = {value=10, method=MLE}
b = {value=0.3, method=MLE}
beta_F_COV_LDOSE = {value=0, method=MLE}
beta_Km_COV_LAGE = {value=0, method=MLE}
beta_Km_COV_LALP = {value=0, method=MLE}
beta_Km_COV_LLBW = {value=0, method=MLE}
beta_Q_COV_LFM = {value=0, method=MLE}
beta_Vc_COV_LLBW = {value=0, method=MLE}
beta_Vp_COV_LFM = {value=0, method=MLE}
beta_ka_COV_FASTED = {value=0, method=MLE}
beta_ka_COV_FED = {value=0, method=MLE}
beta_ka_COV_MORNING = {value=0, method=MLE}
beta_tlag_COV_FASTED = {value=0, method=MLE}
beta_tlag_COV_FED = {value=0, method=MLE}
ka_pop = {value=0.63113737, method=MLE}
omega_F = {value=0.5, method=MLE}
omega_Km = {value=0.5, method=MLE}
omega_Q = {value=0.5, method=MLE}
omega_Vc = {value=0.5, method=MLE}
omega_Vm = {value=0.5, method=MLE}
omega_Vp = {value=0.5, method=MLE}
omega_ka = {value=0.5, method=MLE}
omega_tlag = {value=0.5, method=MLE}
tlag_pop = {value=0.28444636, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMode })
logLikelihood(method = ImportanceSampling)

[SETTINGS]
GLOBAL:
exportpath = 'out'
