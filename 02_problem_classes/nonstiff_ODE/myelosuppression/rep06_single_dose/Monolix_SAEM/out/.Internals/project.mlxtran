<DATAFILE>

[FILEINFO]
file={path='../../data.csv'}
delimiter = comma
header={ID, TIME, AMT, DV, YTYPE, MDV, EVID}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, yname={'1', '2'}, type={continuous, continuous}}
YTYPE = {use=observationtype}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {V_pop, omega_V, Cl_pop, omega_Cl, Circ0_pop, omega_Circ0, MTT_pop, omega_MTT, gamma_pop, Slope_pop, omega_Slope}

DEFINITION:
V = {distribution=logNormal, typical=V_pop, sd=omega_V}
Cl = {distribution=logNormal, typical=Cl_pop, sd=omega_Cl}
Circ0 = {distribution=logNormal, typical=Circ0_pop, sd=omega_Circ0}
MTT = {distribution=logNormal, typical=MTT_pop, sd=omega_MTT}
gamma = {distribution=logNormal, typical=gamma_pop, no-variability}
Slope = {distribution=logNormal, typical=Slope_pop, sd=omega_Slope}

[LONGITUDINAL]
input = {b1, b2}

file = '../../model.txt'

DEFINITION:
y1 = {distribution=normal, prediction=Cc, errorModel=proportional(b1)}
y2 = {distribution=normal, prediction=Circ, errorModel=proportional(b2)}

<FIT>
data = {'1', '2'}
model = {y1, y2}

<PARAMETER>
Circ0_pop = {value=6, method=MLE}
Cl_pop = {value=21, method=MLE}
MTT_pop = {value=63, method=MLE}
Slope_pop = {value=6, method=MLE}
V_pop = {value=78, method=MLE}
b1 = {value=0.3, method=MLE}
b2 = {value=0.3, method=MLE}
c1 = {value=1, method=FIXED}
c2 = {value=1, method=FIXED}
gamma_pop = {value=0.255, method=MLE}
omega_Circ0 = {value=0.5, method=MLE}
omega_Cl = {value=0.5, method=MLE}
omega_MTT = {value=0.5, method=MLE}
omega_Slope = {value=0.5, method=MLE}
omega_V = {value=0.5, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = conditionalMode)
fim(run = false,method = none )
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = false
plots = {}

[SETTINGS]
GLOBAL:
exportpath = '../'

