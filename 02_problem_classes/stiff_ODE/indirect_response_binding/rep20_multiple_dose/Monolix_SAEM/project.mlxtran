<DATAFILE>

[FILEINFO]
file = 'data.csv'
delimiter = comma
header = {ID, TIME, AMT, DV, YTYPE, MDV, EVID}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, yname={'1', '2'}, type={continuous, continuous}}
YTYPE = {use=observationtype}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {ka_pop, omega_ka, V_pop, omega_V, Cl_pop, omega_Cl, R0_pop, omega_R0, kout_pop, omega_kout, KD_pop, omega_KD}

DEFINITION:
ka = {distribution=logNormal, typical=ka_pop, sd=omega_ka}
V = {distribution=logNormal, typical=V_pop, sd=omega_V}
Cl = {distribution=logNormal, typical=Cl_pop, sd=omega_Cl}
R0 = {distribution=logNormal, typical=R0_pop, sd=omega_R0}
kout = {distribution=logNormal, typical=kout_pop, sd=omega_kout}
KD = {distribution=logNormal, typical=KD_pop, sd=omega_KD}

[LONGITUDINAL]
input = {b1, a2}

file = 'model.txt'

DEFINITION:
y1 = {distribution=normal, prediction=Cc, errorModel=proportional(b1)}
y2 = {distribution=normal, prediction=R, errorModel=constant(a2)}

<FIT>
data = {'1', '2'}
model = {y1, y2}

<PARAMETER>
Cl_pop = {value=2.8, method=MLE}
KD_pop = {value=0.6, method=MLE}
R0_pop = {value=90, method=MLE}
V_pop = {value=70, method=MLE}
a2 = {value=10, method=MLE}
b1 = {value=0.3, method=MLE}
ka_pop = {value=0.6, method=MLE}
kout_pop = {value=0.15, method=MLE}
omega_Cl = {value=0.5, method=MLE}
omega_KD = {value=0.5, method=MLE}
omega_R0 = {value=0.5, method=MLE}
omega_V = {value=0.5, method=MLE}
omega_ka = {value=0.5, method=MLE}
omega_kout = {value=0.5, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMode })
logLikelihood(method = ImportanceSampling)

[SETTINGS]
GLOBAL:
exportpath = 'out'
