<DATAFILE>

[FILEINFO]
file={path='../../../data.csv'}
delimiter = comma
header={ID, TIME, AMT, DV, YTYPE, MDV, EVID}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, yname={'1', '2'}, type={continuous, continuous}}
YTYPE = {use=observationtype}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {Cl_pop, omega_Cl, V1_pop, omega_V1, Q_pop, V2_pop, omega_V2, R0_pop, omega_R0, kdeg_pop, kint_pop, KD_pop}

DEFINITION:
Cl = {distribution=logNormal, typical=Cl_pop, sd=omega_Cl}
V1 = {distribution=logNormal, typical=V1_pop, sd=omega_V1}
Q = {distribution=logNormal, typical=Q_pop, no-variability}
V2 = {distribution=logNormal, typical=V2_pop, sd=omega_V2}
R0 = {distribution=logNormal, typical=R0_pop, sd=omega_R0}
kdeg = {distribution=logNormal, typical=kdeg_pop, no-variability}
kint = {distribution=logNormal, typical=kint_pop, no-variability}
KD = {distribution=logNormal, typical=KD_pop, no-variability}

[LONGITUDINAL]
input = {b1, b2}

file = '../../../model.txt'

DEFINITION:
y1 = {distribution=normal, prediction=C, errorModel=proportional(b1)}
y2 = {distribution=normal, prediction=Rtot, errorModel=proportional(b2)}

<FIT>
data = {'1', '2'}
model = {y1, y2}

<PARAMETER>
Cl_pop = {value=0.28, method=MLE}
KD_pop = {value=0.6, method=MLE}
Q_pop = {value=0.75, method=MLE}
R0_pop = {value=14, method=MLE}
V1_pop = {value=2.1, method=MLE}
V2_pop = {value=1.75, method=MLE}
b1 = {value=0.3, method=MLE}
b2 = {value=0.3, method=MLE}
c1 = {value=1, method=FIXED}
c2 = {value=1, method=FIXED}
kdeg_pop = {value=0.35, method=MLE}
kint_pop = {value=0.075, method=MLE}
omega_Cl = {value=0.5, method=MLE}
omega_R0 = {value=0.5, method=MLE}
omega_V1 = {value=0.5, method=MLE}
omega_V2 = {value=0.5, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = conditionalMode)
fim(run = false,method = none )
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = false
plots = {}

[SETTINGS]
GLOBAL:
exportpath = '../../'

