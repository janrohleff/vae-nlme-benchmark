<DATAFILE>

[FILEINFO]
file={path='../../data.csv'}
delimiter = comma
header={ID, TIME, AMT, DV, MDV, EVID}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, type=continuous}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {ka_pop, omega_ka, V_pop, omega_V, Vm_pop, omega_Vm, Km_pop, omega_Km}

DEFINITION:
ka = {distribution=logNormal, typical=ka_pop, sd=omega_ka}
V = {distribution=logNormal, typical=V_pop, sd=omega_V}
Vm = {distribution=logNormal, typical=Vm_pop, sd=omega_Vm}
Km = {distribution=logNormal, typical=Km_pop, sd=omega_Km}

[LONGITUDINAL]
input = {b}

file = 'lib:oral1_1cpt_kaVVmKm.txt'

DEFINITION:
DV = {distribution=normal, prediction=Cc, errorModel=proportional(b)}

<FIT>
data = 'DV'
model = DV

<PARAMETER>
Km_pop = {value=3, method=MLE}
V_pop = {value=70, method=MLE}
Vm_pop = {value=7, method=MLE}
b = {value=0.3, method=MLE}
c = {value=1, method=FIXED}
ka_pop = {value=0.6, method=MLE}
omega_Km = {value=0.5, method=MLE}
omega_V = {value=0.5, method=MLE}
omega_Vm = {value=0.5, method=MLE}
omega_ka = {value=0.5, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = conditionalMode)
fim(run = false,method = none )
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = false
plots = {}

[SETTINGS]
GLOBAL:
exportpath = '../'

