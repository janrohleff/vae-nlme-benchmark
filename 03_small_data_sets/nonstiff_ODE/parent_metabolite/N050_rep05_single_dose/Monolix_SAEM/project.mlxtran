<DATAFILE>

[FILEINFO]
file = 'data.csv'
delimiter = comma
header = {ID, TIME, AMT, DV, YTYPE, MDV, EVID}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, yname={'1', '2'}, type={continuous, continuous}}
YTYPE = {use=observationtype}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {ka_pop, omega_ka, V_pop, omega_V, Cl_pop, omega_Cl, Vmet_pop, omega_Vmet, Clmet_pop, omega_Clmet}

DEFINITION:
ka = {distribution=logNormal, typical=ka_pop, sd=omega_ka}
V = {distribution=logNormal, typical=V_pop, sd=omega_V}
Cl = {distribution=logNormal, typical=Cl_pop, sd=omega_Cl}
Vmet = {distribution=logNormal, typical=Vmet_pop, sd=omega_Vmet}
Clmet = {distribution=logNormal, typical=Clmet_pop, sd=omega_Clmet}

[LONGITUDINAL]
input = {b1, b2}

file = 'model.txt'

DEFINITION:
y1 = {distribution=normal, prediction=Cp, errorModel=proportional(b1)}
y2 = {distribution=normal, prediction=Cm, errorModel=proportional(b2)}

<FIT>
data = {'1', '2'}
model = {y1, y2}

<PARAMETER>
Cl_pop = {value=7, method=MLE}
Clmet_pop = {value=1.8, method=MLE}
V_pop = {value=70, method=MLE}
Vmet_pop = {value=42, method=MLE}
b1 = {value=0.3, method=MLE}
b2 = {value=0.3, method=MLE}
ka_pop = {value=0.6, method=MLE}
omega_Cl = {value=0.5, method=MLE}
omega_Clmet = {value=0.5, method=MLE}
omega_V = {value=0.5, method=MLE}
omega_Vmet = {value=0.5, method=MLE}
omega_ka = {value=0.5, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMode })
logLikelihood(method = ImportanceSampling)

[SETTINGS]
GLOBAL:
exportpath = 'out'
