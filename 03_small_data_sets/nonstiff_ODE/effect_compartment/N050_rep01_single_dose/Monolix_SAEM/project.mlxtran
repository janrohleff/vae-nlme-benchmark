<DATAFILE>

[FILEINFO]
file = 'data.csv'
delimiter = comma
header = {ID, TIME, AMT, DV, YTYPE, MDV, EVID}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, yname={'1', '2'}, type={continuous, continuous}}
YTYPE = {use=observationtype}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {ka_pop, omega_ka, V_pop, omega_V, Cl_pop, omega_Cl, ke0_pop, omega_ke0, E0_pop, omega_E0, Emax_pop, omega_Emax, EC50_pop, omega_EC50}

DEFINITION:
ka = {distribution=logNormal, typical=ka_pop, sd=omega_ka}
V = {distribution=logNormal, typical=V_pop, sd=omega_V}
Cl = {distribution=logNormal, typical=Cl_pop, sd=omega_Cl}
ke0 = {distribution=logNormal, typical=ke0_pop, sd=omega_ke0}
E0 = {distribution=logNormal, typical=E0_pop, sd=omega_E0}
Emax = {distribution=logNormal, typical=Emax_pop, sd=omega_Emax}
EC50 = {distribution=logNormal, typical=EC50_pop, sd=omega_EC50}

[LONGITUDINAL]
input = {b1, a2}

file = 'model.txt'

DEFINITION:
y1 = {distribution=normal, prediction=Cc, errorModel=proportional(b1)}
y2 = {distribution=normal, prediction=E, errorModel=constant(a2)}

<FIT>
data = {'1', '2'}
model = {y1, y2}

<PARAMETER>
Cl_pop = {value=2.8, method=MLE}
E0_pop = {value=12, method=MLE}
EC50_pop = {value=3, method=MLE}
Emax_pop = {value=35, method=MLE}
V_pop = {value=70, method=MLE}
a2 = {value=5, method=MLE}
b1 = {value=0.3, method=MLE}
ka_pop = {value=0.6, method=MLE}
ke0_pop = {value=0.45, method=MLE}
omega_Cl = {value=0.5, method=MLE}
omega_E0 = {value=0.5, method=MLE}
omega_EC50 = {value=0.5, method=MLE}
omega_Emax = {value=0.5, method=MLE}
omega_V = {value=0.5, method=MLE}
omega_ka = {value=0.5, method=MLE}
omega_ke0 = {value=0.5, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMode })
logLikelihood(method = ImportanceSampling)

[SETTINGS]
GLOBAL:
exportpath = 'out'
