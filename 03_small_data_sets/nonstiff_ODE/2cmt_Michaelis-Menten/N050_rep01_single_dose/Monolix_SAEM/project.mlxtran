<DATAFILE>

[FILEINFO]
file = 'data.csv'
delimiter = comma
header = {ID, TIME, AMT, DV, MDV, EVID}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, name=DV, type=continuous}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {V1_pop, omega_V1, Q_pop, V2_pop, omega_V2, Vm_pop, omega_Vm, Km_pop, omega_Km}

DEFINITION:
V1 = {distribution=logNormal, typical=V1_pop, sd=omega_V1}
Q = {distribution=logNormal, typical=Q_pop, no-variability}
V2 = {distribution=logNormal, typical=V2_pop, sd=omega_V2}
Vm = {distribution=logNormal, typical=Vm_pop, sd=omega_Vm}
Km = {distribution=logNormal, typical=Km_pop, sd=omega_Km}

[LONGITUDINAL]
input = {b}

file = 'lib:bolus_2cpt_V1QV2VmKm.txt'

DEFINITION:
DV = {distribution=normal, prediction=Cc, errorModel=proportional(b)}

<FIT>
data = DV
model = DV

<PARAMETER>
Km_pop = {value=3, method=MLE}
Q_pop = {value=3, method=MLE}
V1_pop = {value=14, method=MLE}
V2_pop = {value=21, method=MLE}
Vm_pop = {value=14, method=MLE}
b = {value=0.3, method=MLE}
omega_Km = {value=0.5, method=MLE}
omega_V1 = {value=0.5, method=MLE}
omega_V2 = {value=0.5, method=MLE}
omega_Vm = {value=0.5, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMode })
logLikelihood(method = ImportanceSampling)

[SETTINGS]
GLOBAL:
exportpath = 'out'
