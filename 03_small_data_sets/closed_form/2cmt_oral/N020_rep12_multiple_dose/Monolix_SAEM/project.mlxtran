<DATAFILE>

[FILEINFO]
file = 'data.csv'
delimiter = comma
header = {ID, TIME, AMT, DV, MDV, EVID}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, name=DV, type=continuous}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {ka_pop, omega_ka, Cl_pop, omega_Cl, V1_pop, omega_V1, Q_pop, omega_Q, V2_pop, omega_V2}

DEFINITION:
ka = {distribution=logNormal, typical=ka_pop, sd=omega_ka}
Cl = {distribution=logNormal, typical=Cl_pop, sd=omega_Cl}
V1 = {distribution=logNormal, typical=V1_pop, sd=omega_V1}
Q = {distribution=logNormal, typical=Q_pop, sd=omega_Q}
V2 = {distribution=logNormal, typical=V2_pop, sd=omega_V2}

[LONGITUDINAL]
input = {b}

file = 'lib:oral1_2cpt_kaClV1QV2.txt'

DEFINITION:
DV = {distribution=normal, prediction=Cc, errorModel=proportional(b)}

<FIT>
data = DV
model = DV

<PARAMETER>
Cl_pop = {value=3.5, method=MLE}
Q_pop = {value=2.4, method=MLE}
V1_pop = {value=28, method=MLE}
V2_pop = {value=42, method=MLE}
b = {value=0.3, method=MLE}
ka_pop = {value=1.2, method=MLE}
omega_Cl = {value=0.5, method=MLE}
omega_Q = {value=0.5, method=MLE}
omega_V1 = {value=0.5, method=MLE}
omega_V2 = {value=0.5, method=MLE}
omega_ka = {value=0.5, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMode })
logLikelihood(method = ImportanceSampling)

[SETTINGS]
GLOBAL:
exportpath = 'out'
