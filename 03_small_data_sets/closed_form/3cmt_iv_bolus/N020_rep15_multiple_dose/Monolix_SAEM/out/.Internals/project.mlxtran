<DATAFILE>

[FILEINFO]
file={path='../../data.csv'}
delimiter = comma
header={ID, TIME, AMT, DV, MDV, EVID}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
AMT = {use=amount}
DV = {use=observation, type=continuous}
MDV = {use=missingdependentvariable}
EVID = {use=eventidentifier}

<MODEL>

[INDIVIDUAL]
input = {Cl_pop, omega_Cl, V1_pop, omega_V1, Q2_pop, V2_pop, omega_V2, Q3_pop, V3_pop, omega_V3}

DEFINITION:
Cl = {distribution=logNormal, typical=Cl_pop, sd=omega_Cl}
V1 = {distribution=logNormal, typical=V1_pop, sd=omega_V1}
Q2 = {distribution=logNormal, typical=Q2_pop, no-variability}
V2 = {distribution=logNormal, typical=V2_pop, sd=omega_V2}
Q3 = {distribution=logNormal, typical=Q3_pop, no-variability}
V3 = {distribution=logNormal, typical=V3_pop, sd=omega_V3}

[LONGITUDINAL]
input = {b}

file = 'lib:bolus_3cpt_ClV1Q2V2Q3V3.txt'

DEFINITION:
DV = {distribution=normal, prediction=Cc, errorModel=proportional(b)}

<FIT>
data = 'DV'
model = DV

<PARAMETER>
Cl_pop = {value=7, method=MLE}
Q2_pop = {value=15, method=MLE}
Q3_pop = {value=1.2, method=MLE}
V1_pop = {value=7, method=MLE}
V2_pop = {value=21, method=MLE}
V3_pop = {value=140, method=MLE}
b = {value=0.3, method=MLE}
c = {value=1, method=FIXED}
omega_Cl = {value=0.5, method=MLE}
omega_V1 = {value=0.5, method=MLE}
omega_V2 = {value=0.5, method=MLE}
omega_V3 = {value=0.5, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = conditionalMode)
fim(run = false,method = none )
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = false
plots = {}

[SETTINGS]
GLOBAL:
exportpath = '../'

